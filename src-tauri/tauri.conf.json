{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Otaria",
  "version": "0.1.3",
  "identifier": "dev.otaria.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Otaria",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0MzJFNTg2NTBCM0I1MTQKUldRVXRiTlFodVV5UkFrUUE0SWs2NEhpTGNYaWJoaDNOYUF2NEZtbWU4YlovTUtEWGJtYWhFZWwK",
      "endpoints": [
        "https://github.com/Rhaima96/otaria-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
